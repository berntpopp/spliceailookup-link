# Docker environment for spliceailookup-link behind Nginx Proxy Manager.
# Copy to .env.docker for the NPM compose deployment:
#
#   cp .env.docker.example .env.docker
#
# All keys are optional (the image and docker-compose.npm.yml carry safe
# defaults); this file mainly pins the external NPM network and lets you tune
# logging / resource limits without editing the compose file.

# ---- Nginx Proxy Manager (docker-compose.npm.yml) ----
# External NPM network the container joins for reverse-proxy routing.
NPM_SHARED_NETWORK_NAME=npm_default

# Exact public request boundary. Hosts omit schemes/ports and use bare ::1 for
# IPv6. Wildcards are rejected. Keep browser Origins aligned with CORS.
SPLICEAILOOKUP_LINK_ALLOWED_HOSTS=["localhost","127.0.0.1","::1","spliceailookup-link.genefoundry.org"]
SPLICEAILOOKUP_LINK_ALLOWED_ORIGINS=["https://spliceailookup-link.genefoundry.org"]
SPLICEAILOOKUP_LINK_CORS_ORIGINS=https://spliceailookup-link.genefoundry.org

# ---- Logging ----
LOG_LEVEL_API=INFO

# ---- NPM resource limits (optional) ----
SPLICEAI_API_MEMORY_LIMIT=512m
SPLICEAI_API_CPU_LIMIT=0.5
